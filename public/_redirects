# Static, crawlable pages must be served as themselves. Without these
# exclusions the SPA catch-all below rewrites every URL to index.html, so
# Googlebot sees an empty React shell instead of content.
/notes/subjects/  /notes/subjects/index.html  200
/notes/*      /notes/:splat   200
/home.html    /home.html      200
/sitemap.xml  /sitemap.xml    200
/robots.txt   /robots.txt     200

# SPA catch-all — everything else is handled by React Router.
/*  /index.html  200
